# Copia este archivo a .env y completa los valores reales. Ninguno de estos
# valores debe subirse al repositorio (.env está en .gitignore).

# Cadena de conexión a Postgres (ej. Prisma Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos"

# Login del médico (usuario único, MVP). Genera el hash con:
# node -e "console.log(require('bcryptjs').hashSync('TU_PASSWORD', 10))"
# Ojo: si el hash contiene '$', escápalos como '\$' en este archivo.
AUTH_USERNAME="medico"
AUTH_PASSWORD_HASH=""
AUTH_SECRET=""

# Número de WhatsApp del consultorio para el botón "Agendar por WhatsApp"
# en /reservar (formato internacional sin +, ej. 584141234567).
NEXT_PUBLIC_WHATSAPP_NUMBER="584140000000"

# --- Bot de WhatsApp (Meta Cloud API) ---
# Token arbitrario que defines tú mismo y pegas también en la
# configuración del webhook dentro del panel de Meta for Developers.
WHATSAPP_VERIFY_TOKEN=""
# App secret de tu app de Meta (para verificar la firma de cada webhook).
WHATSAPP_APP_SECRET=""
# Token de acceso (System User, permanente) de la WhatsApp Business API.
WHATSAPP_ACCESS_TOKEN=""
# ID del número de teléfono dentro de Meta (no es el número en sí).
WHATSAPP_PHONE_NUMBER_ID=""
